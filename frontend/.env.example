# Frontend configuration. This is the BROWSER side.
#
#   cd frontend
#   cp .env.example .env.local
#
# .env.local is git-ignored and is the one Vite actually reads.
#
# Only variables prefixed VITE_ are exposed to browser code, and Vite inlines
# them at BUILD time, so every value here ships to the client in plain text.
# Never put a secret in this file. There is nothing to hide here by design:
# the server's config — including UNOROUTER_API_KEY and the database password
# — lives in backend/.env, which the browser never sees.

# ---- API base URL ----
# Leave EMPTY for normal development. An empty value makes the app issue
# same-origin relative requests to /api, which the Vite dev proxy forwards to
# http://localhost:8000 (see server.proxy in vite.config.ts). That keeps the
# browser on one origin, so there is no CORS negotiation at all — and the
# backend only allows localhost:5173 anyway.
#
# Set it ONLY when the API is on a different origin, e.g. hitting a backend on
# another machine, or serving the built bundle from something other than Vite:
#   VITE_API_BASE_URL=http://192.168.1.50:8000/api
#
# Include the /api suffix if you set it. No trailing slash.
VITE_API_BASE_URL=

# ---- Request timeout (ms) ----
# The tailor endpoint runs a multi-agent LangGraph pass with a critic loop;
# UnoRouter's free tier averages ~10 s per call and the graph makes several.
# 90000 matches LLM_TIMEOUT_SECONDS=90 in backend/.env.
VITE_API_TIMEOUT_MS=90000
