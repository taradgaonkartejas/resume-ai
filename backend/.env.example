# Backend configuration. This file lives in backend/, NOT the repo root.
#
#   cd backend
#   cp .env.example .env        (or: make env-file / .\make.ps1 env-file)
#
# app/config.py anchors to backend/ via BACKEND_DIR, so it resolves no matter
# which directory you launch uvicorn from.
#
# This is the SERVER side. It holds real secrets and is git-ignored.
# The browser app has its own file, frontend/.env.local, which holds only
# VITE_-prefixed values and ships to the client — never put a key there.

# ---- LLM (optional: the app runs without a key, with degraded features) ----
#
# One key per provider; you need at least one, not all. Models are addressed
# as "provider:model", and a chain spans vendors so a rate limit on one
# degrades to another company's hardware instead of a sibling model behind
# the same limiter. Base URLs are facts about the vendor and live in
# app/ai/llm.py PROVIDERS, not here.
#
# NOTE: every comment below is on its OWN line, deliberately. A trailing
# comment on an assignment line is loaded as part of the value -- an unfilled
# `KEY=   # some note` arrives as the literal text "# some note", and the app
# then tries it and gets a 401 that looks like an entitlement problem rather
# than an unset key. Keep comments above the line they describe.
#
# Free, no credit card. NVIDIA and Groq do not train on your data.

# build.nvidia.com -- ~40 req/min, no daily token cap
NVIDIA_API_KEY=

# console.groq.com -- 30 req/min, 8k tokens/min (the token cap binds first:
# at our ~714 tokens/call average that is ~11 real requests/min, not 30)
GROQ_API_KEY=

# codecraftapi.com -- 1M tokens/month, 60 req/min, whole catalogue on free.
#
# READ BEFORE SETTING. This provider names NO upstream vendor anywhere on
# its site, and its catalogue is internally inconsistent (a model described
# as a Meta series carries Zhipu's logo; several ids are not products the
# named vendor ships). You therefore cannot know whose servers your data
# reaches, in what country, or under what retention.
#
# That is tolerable for MODEL_ATS, whose entire payload is a list of
# certification acronyms -- `tests/test_ats_payload_privacy.py` enforces
# that it stays that way. It is NOT the same bargain for MODEL_WRITING,
# MODEL_EXTRACTION, MODEL_SCORING or MODEL_CHAT, which send the resume
# itself: real name, phone, address, employers and dates.
#
# Leave blank to keep everything on NVIDIA + Groq.
CODECRAFT_API_KEY=

# Legacy. Its free tier is 1 request per minute per model per account, which
# is why the app moved off it. Kept only so an unqualified model id ending
# ":free" in an older .env still routes here instead of being sent to NVIDIA.
# Leave blank unless you still use it.
UNOROUTER_API_KEY=

# Per-task routing. writing/chat get a chat-tuned model because the user reads
# that prose; critique runs on a DIFFERENT VENDOR on purpose, because a critic
# that shares the writer's model shares its blind spots.
# Verify every id with `make models` BEFORE trusting a report that names it.
# Being listed in a provider's catalogue is not the same as being callable by
# your account: kimi-k2.6 is in NVIDIA's list of 81 and still returns
# 404 "Function not found for account". `make models --probe nvidia` sends one
# real 1-token call to every chat model it advertises and prints what answers.
# Only models with a "Free Endpoint" badge on build.nvidia.com, or on Groq's
# free list. An NVIDIA model without that badge is listed but not callable:
# it returns 404 "Function '<uuid>': Not found for account '<id>'".
MODEL_DEFAULT=groq:openai/gpt-oss-120b
MODEL_WRITING=nvidia:nvidia/nemotron-3-ultra-550b-a55b
MODEL_CHAT=groq:openai/gpt-oss-120b
MODEL_CRITIQUE=groq:openai/gpt-oss-120b
MODEL_EXTRACTION=groq:openai/gpt-oss-120b
MODEL_JD_ANALYSIS=groq:openai/gpt-oss-120b
MODEL_SCORING=groq:openai/gpt-oss-20b
MODEL_ATS=groq:openai/gpt-oss-120b
EMBEDDING_MODEL=nvidia:nvidia/nemotron-3-embed-1b
# Refuse any model that is not free on the plan we are on, before a request is
# sent. Freeness is declared per provider in llm.PROVIDERS -- it is a property
# of your account, not of the model's name. The fallback chain is the path
# that would otherwise quietly reach a paid model. Set false only if you
# intend to be billed.
FREE_MODELS_ONLY=true
# Embeddings run locally. The free remote embedder reports 24.3% success and
# does not emit EMBEDDING_DIM-sized vectors, so enabling it mixes two
# incomparable vector spaces in one index.
EMBEDDINGS_REMOTE=false
LLM_TIMEOUT_SECONDS=45

# ---- Database ----
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB in docker-compose.yml.
# Host port is 5433 (container 5432).
#
# IMPORTANT: any of  @ : / ? # [ ] %  in the password must be percent-encoded.
#   Admin@123  ->  Admin%40123
# An unencoded '@' silently parses as a host separator: SQLAlchemy reads the
# host as "123@localhost" and the error blames the host, not the password.
DATABASE_URL=postgresql+psycopg2://admin:Admin123@localhost:5433/resumeai
ALLOW_SQLITE_FALLBACK=true

# ---- Object storage ----
# Must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD in docker-compose.yml.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio123
S3_BUCKET_UPLOADS=resumeai-uploads
S3_BUCKET_EXPORTS=resumeai-exports
ALLOW_DISK_FALLBACK=true

# ---- Redis ----
REDIS_URL=redis://localhost:6379/0

# ---- App ----
SEED_USER_COUNT=5
CHAT_TOKEN_ALLOWANCE=25
MAX_UPLOAD_MB=10
EMBEDDING_DIM=384
